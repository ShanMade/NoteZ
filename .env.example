# ByNote Environment Configuration
# Duplicate this file to .env.local or set these variables in your deployment host / GitHub Secrets.

# Relational Database (e.g. Neon, Supabase, Cloud SQL, or local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Gemini AI Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Qdrant Vector Engine (Cloud or Self-Hosted)
# For Qdrant Cloud: https://xyz-example.qdrant.tech:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Firebase Client Configuration (ai-notez / byote.web.app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-notez.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ai-notez-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-notez
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-notez.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=275128405663
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FFDFQ48X7K
